class Solution(object):
    def removeDuplicates(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        m = set()

        for i in nums:
            m.add(i)

        i=0
        j=1
        while i < len(m):
            
            if nums[i] != nums[j]:
                nums[i] = nums[j]

            i += 1
            j += 1
        
        return len(m) , nums

s = Solution()

print(s.removeDuplicates([1,1,2]))